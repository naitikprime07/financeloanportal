.blog-detail-page {
    padding: 28px 0 56px
}

.blog-breadcrumb {
    display: flex;
    align-items: center;
    gap: 9px;
    margin: 0 0 24px;
    color: var(--text-gray);
    font-size: 13px;
    white-space: nowrap;
    overflow: hidden
}

.blog-breadcrumb a {
    color: var(--primary-color);
    font-weight: 600
}

.blog-breadcrumb>span:last-child {
    overflow: hidden;
    text-overflow: ellipsis
}

.blog-detail-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 320px;
    align-items: start;
    gap: 40px
}

.blog-detail-content {
    min-width: 0;
    background: var(--bg-white);
    border-radius: 14px;
    padding: 42px;
    box-shadow: var(--shadow-sm)
}

.blog-detail-header {
    max-width: 820px;
    margin: 0 auto 30px
}

.blog-category-badge {
    display: inline-flex;
    background: var(--primary-color);
    color: #fff;
    padding: 7px 13px;
    border-radius: 6px;
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: .7px;
    margin-bottom: 18px
}

.blog-detail-title {
    font-size: clamp(30px, 4vw, 46px);
    font-weight: 750;
    line-height: 1.16;
    letter-spacing: -.8px;
    margin: 0 0 16px;
    color: var(--text-dark)
}

.blog-detail-lead {
    font-size: 18px;
    line-height: 1.7;
    color: var(--text-light);
    margin: 0 0 24px
}

.blog-detail-meta {
    display: flex;
    align-items: center;
    gap: 10px;
    color: var(--text-gray);
    font-size: 13px
}

.blog-detail-meta>span:not(.blog-meta-avatar):not(.meta-divider) {
    display: flex;
    flex-direction: column
}

.blog-detail-meta strong {
    font-size: 13px;
    color: var(--text-dark)
}

.blog-detail-meta small {
    font-size: 11px
}

.blog-meta-avatar {
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    border-radius: 50%;
    background: var(--primary-color);
    color: #fff;
    font-weight: 700
}

.meta-divider {
    width: 1px;
    height: 32px;
    background: var(--border-color);
    margin: 0 4px
}

.share-button {
    margin-left: auto;
    padding: 9px 14px;
    border: 1px solid var(--border-color);
    border-radius: 8px;
    background: #fff;
    color: var(--primary-color);
    font-size: 12px;
    font-weight: 700
}

.blog-detail-image {
    margin: 0 0 30px;
    border-radius: 12px;
    overflow: hidden;
    background: var(--bg-light)
}

.blog-detail-image img {
    display: block;
    width: 100%;
    aspect-ratio: 16/9;
    object-fit: cover
}

.blog-detail-image figcaption {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0)
}

.blog-detail-body {
    max-width: 780px;
    margin: 0 auto;
    font-size: 17px;
    line-height: 1.85;
    color: var(--text-dark)
}

.blog-section {
    scroll-margin-top: 100px;
    margin: 0 0 38px
}

.blog-section h2 {
    font-size: 27px;
    line-height: 1.3;
    letter-spacing: -.25px;
    margin: 0 0 15px;
    color: var(--text-dark)
}

.blog-section h2.scroll-heading {
    text-align: center;
    font-size: clamp(1.8rem, 4vw, 3rem);
    font-weight: 900;
    padding: 40px 20px;
    margin: 30px 0;
    background: transparent;
    border: none;
    color: #ff4d4d;
    text-shadow: 2px 2px 4px rgba(255, 77, 77, .2);
    letter-spacing: 1px
}

@keyframes bounceEmoji {

    0%,
    100% {
        transform: translateY(0)
    }

    50% {
        transform: translateY(-10px)
    }
}

.rewards-details {
    margin: 25px 0;
    padding: 0
}

.rewards-title {
    font-size: 22px;
    font-weight: 700;
    margin: 0 0 18px;
    color: var(--text-dark)
}

.reward-item {
    background: #f8f9fa;
    border: 1px solid #e5e7eb;
    border-radius: 8px;
    margin-bottom: 12px;
    overflow: hidden;
    transition: all .2s ease
}

.reward-item:last-child {
    margin-bottom: 0
}

.reward-item summary {
    padding: 16px 20px;
    cursor: pointer;
    list-style: none;
    user-select: none;
    position: relative;
    font-size: 15px;
    color: var(--text-dark)
}

.reward-item summary::-webkit-details-marker {
    display: none
}

.reward-item summary::before {
    content: '+';
    position: absolute;
    right: 20px;
    font-size: 20px;
    font-weight: 700;
    color: var(--primary-color);
    transition: transform .2s ease
}

.reward-item[open] summary::before {
    transform: rotate(45deg)
}

.reward-item summary strong {
    display: block;
    font-weight: 700
}

.reward-item p {
    margin: 0;
    padding: 0 20px 16px;
    color: var(--text-light);
    font-size: 14px;
    line-height: 1.6
}

.faq-section {
    margin: 25px 0;
    padding: 0
}

.faq-item {
    background: #f8f9fa;
    border: 1px solid #e5e7eb;
    border-radius: 8px;
    margin-bottom: 12px;
    overflow: hidden;
    transition: all .2s ease
}

.faq-item:last-child {
    margin-bottom: 0
}

.faq-item summary {
    padding: 16px 20px;
    cursor: pointer;
    list-style: none;
    user-select: none;
    position: relative;
    font-size: 15px;
    color: var(--text-dark)
}

.faq-item summary::-webkit-details-marker {
    display: none
}

.faq-item summary::before {
    content: '+';
    position: absolute;
    right: 20px;
    font-size: 20px;
    font-weight: 700;
    color: var(--primary-color);
    transition: transform .2s ease
}

.faq-item[open] summary::before {
    transform: rotate(45deg)
}

.faq-item summary strong {
    display: block;
    font-weight: 700
}

.faq-item p {
    margin: 0;
    padding: 0 20px 16px;
    color: var(--text-light);
    font-size: 14px;
    line-height: 1.6
}

.blog-text p {
    margin: 0 0 18px
}

.blog-text ul {
    margin: 0 0 20px;
    padding-left: 24px
}

.blog-text li {
    margin: 8px 0;
    padding-left: 5px
}

.article-tags {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 9px;
    max-width: 780px;
    margin: 34px auto 0;
    padding-top: 24px;
    border-top: 1px solid var(--border-color)
}

.article-tags>* {
    padding: 7px 11px;
    border-radius: 999px;
    background: var(--bg-light);
    font-size: 12px;
    color: var(--text-light)
}

.article-tags>span:first-child {
    padding-left: 0;
    background: transparent;
    font-weight: 700;
    color: var(--text-dark)
}

.article-tags a {
    color: var(--primary-color);
    font-weight: 600
}

.article-share {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    max-width: 780px;
    margin: 28px auto;
    padding: 22px 24px;
    border: 1px solid var(--border-color);
    border-radius: 12px;
    background: var(--bg-light)
}

.article-share strong {
    font-size: 16px
}

.article-share p {
    margin: 3px 0 0;
    color: var(--text-light);
    font-size: 13px
}

.article-share button {
    padding: 11px 22px;
    border-radius: 8px;
    background: var(--primary-color);
    color: #fff;
    font-weight: 700
}

.article-navigation {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 18px;
    padding-top: 30px;
    border-top: 1px solid var(--border-color)
}

.article-navigation a {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 16px;
    border-radius: 10px;
    background: var(--bg-light)
}

.article-navigation a.next {
    text-align: right
}

.article-navigation small {
    color: var(--primary-color);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: .5px
}

.article-navigation strong {
    font-size: 14px;
    line-height: 1.4;
    color: var(--text-dark)
}

.related-section {
    margin-top: 54px;
    padding-top: 34px;
    border-top: 1px solid var(--border-color)
}

.section-heading {
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: 20px;
    margin-bottom: 22px
}

.section-heading span {
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 1px;
    color: var(--primary-color);
    font-weight: 700
}

.section-heading h2 {
    font-size: 25px;
    margin: 4px 0 0
}

.section-heading>a {
    color: var(--primary-color);
    font-size: 13px;
    font-weight: 700
}

.related-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px
}

.related-card {
    overflow: hidden;
    border: 1px solid var(--border-color);
    border-radius: 11px;
    background: #fff;
    transition: var(--transition)
}

.related-card:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-sm)
}

.related-card img {
    display: block;
    width: 100%;
    aspect-ratio: 16/10;
    object-fit: cover
}

.related-card>div {
    padding: 14px
}

.related-card span {
    font-size: 10px;
    color: var(--primary-color);
    font-weight: 700;
    text-transform: uppercase
}

.related-card h3 {
    font-size: 14px;
    line-height: 1.4;
    margin: 6px 0;
    color: var(--text-dark)
}

.related-card small {
    font-size: 11px;
    color: var(--text-gray)
}

.article-disclosures {
    margin-top: 48px;
    padding: 26px;
    border-radius: 12px;
    background: var(--bg-light)
}

.article-disclosures>h2 {
    font-size: 17px;
    margin: 0 0 18px
}

.article-disclosures>div {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px
}

.article-disclosures h3 {
    font-size: 13px;
    text-transform: uppercase;
    letter-spacing: .5px;
    margin: 0 0 7px
}

.article-disclosures p {
    font-size: 12px;
    line-height: 1.7;
    color: var(--text-light);
    margin: 0
}

.blog-error {
    max-width: 600px;
    margin: 80px auto;
    padding: 50px;
    text-align: center;
    background: #fff;
    border-radius: 14px;
    box-shadow: var(--shadow-sm)
}

.blog-error>span {
    font-size: 13px;
    color: var(--primary-color);
    font-weight: 800
}

.blog-error h1 {
    margin: 8px 0
}

.blog-error p {
    color: var(--text-light)
}

.blog-error a {
    display: inline-block;
    margin-top: 18px;
    padding: 11px 18px;
    border-radius: 8px;
    background: var(--primary-color);
    color: #fff;
    font-weight: 700
}

@media(max-width:1024px) {
    .blog-detail-layout {
        grid-template-columns: 1fr
    }

    .blog-detail-content {
        padding: 34px
    }
}

@media(max-width:768px) {
    .blog-detail-page {
        padding: 18px 0 38px
    }

    .blog-breadcrumb {
        margin-bottom: 16px
    }

    .blog-detail-content {
        padding: 22px 18px;
        border-radius: 10px
    }

    .blog-detail-header {
        margin-bottom: 22px
    }

    .blog-detail-title {
        font-size: 29px;
        letter-spacing: -.35px
    }

    .blog-detail-lead {
        font-size: 16px
    }

    .blog-detail-meta {
        flex-wrap: wrap
    }

    .meta-divider {
        display: none
    }

    .share-button {
        width: 100%;
        margin: 7px 0 0
    }

    .blog-detail-image {
        margin-left: -18px;
        margin-right: -18px;
        border-radius: 0
    }

    .blog-detail-body {
        font-size: 16px;
        line-height: 1.78
    }

    .blog-section {
        margin-bottom: 30px
    }

    .blog-section h2 {
        font-size: 22px
    }

    .article-share {
        align-items: flex-start;
        flex-direction: column
    }

    .article-share button {
        width: 100%
    }

    .article-navigation {
        grid-template-columns: 1fr
    }

    .article-navigation a.next {
        text-align: left
    }

    .related-grid {
        grid-template-columns: 1fr
    }

    .related-card {
        display: grid;
        grid-template-columns: 112px 1fr
    }

    .related-card img {
        height: 100%;
        aspect-ratio: auto
    }

    .article-disclosures>div {
        grid-template-columns: 1fr
    }

    .section-heading {
        align-items: flex-start
    }

    .section-heading>a {
        white-space: nowrap
    }
}